{
  "name": "hbssh",
  "version": "0.1.0",
  "description": "hbssh ssh client for MacOS and Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --inspect",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "ssh",
    "terminal",
    "server"
  ],
  "author": "HBTech",
  "license": "UNLICENSED",
  "dependencies": {
    "@xterm/addon-fit": "^0.9.0",
    "@xterm/xterm": "^5.5.0",
    "electron-store": "^8.1.0",
    "node-pty": "^1.0.0",
    "os-utils": "^0.0.14",
    "ssh2": "^1.15.0",
    "ssh2-sftp-client": "^9.1.0"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9"
  },
  "build": {
    "appId": "com.hbssh.app",
    "productName": "HBSSH",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "ssh-logo.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "ssh-logo.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "identity": null,
      "icon": "ssh-logo.png"
    }
  }
}
